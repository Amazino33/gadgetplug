<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- Force the inert drivers regardless of real keys in a developer's local .env -->
        <env name="MESSAGING_WHATSAPP_DRIVER" value="log_null"/>
        <env name="MESSAGING_SMS_DRIVER" value="log_null"/>
        <env name="MESSAGING_REDIRECT_ALL_TO" value=""/>
        <!-- Blank the provider credentials as well. Tests that null the *_DRIVER
             config at runtime to exercise auto-selection would otherwise fall
             through to whichever provider has real keys locally and, with no
             Http::fake() in place, send live messages during a test run. -->
        <env name="WAWP_INSTANCE_ID" value=""/>
        <env name="WAWP_ACCESS_TOKEN" value=""/>
        <env name="WHATSAPP_CLOUD_TOKEN" value=""/>
        <env name="WHATSAPP_CLOUD_PHONE_NUMBER_ID" value=""/>
        <env name="TERMII_API_KEY" value=""/>
        <env name="TERMII_SENDER_ID" value=""/>
        <!-- Every other credential gets a dummy, so a developer's real key in
             .env can never be used — or printed in a failure — by a test. The
             messaging providers above stay blank on purpose (blank = no live
             driver is auto-selected). No request leaves the machine anyway:
             tests/TestCase.php refuses stray HTTP and fakes the known hosts. -->
        <env name="META_PIXEL_ID" value="000000000000000"/>
        <env name="META_CAPI_ACCESS_TOKEN" value="test-meta-capi-token"/>
        <env name="META_TEST_EVENT_CODE" value=""/>
        <env name="PAYSTACK_PUBLIC_KEY" value="pk_test_dummy"/>
        <env name="PAYSTACK_SECRET_KEY" value="sk_test_dummy"/>
        <env name="TELEGRAM_BOT_TOKEN" value="test-telegram-token"/>
        <env name="TELEGRAM_CHAT_ID" value="0"/>
        <env name="ANTHROPIC_API_KEY" value="test-anthropic-key"/>
        <env name="REPLICATE_API_TOKEN" value="test-replicate-token"/>
        <env name="AWS_ACCESS_KEY_ID" value="test-aws-key"/>
        <env name="AWS_SECRET_ACCESS_KEY" value="test-aws-secret"/>
        <env name="MAIL_PASSWORD" value="test-mail-password"/>
    </php>
</phpunit>
